# Copy to .dev.vars for local `wrangler dev` (never commit the real .dev.vars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: dedicated session-cookie HMAC key. Derived from ADMIN_PASSWORD when unset
# (rotating the password then invalidates existing sessions once).
# SESSION_SECRET=<random string>

# Optional: legacy login scheme (pre-hashed password) as an alternative to ADMIN_PASSWORD.
# ADMIN_PASSWORD_SHA256=<sha256 hex>

# Optional: salt for node token hashes. The local seed data (scripts/seed-local.sql,
# tokens dev-token-1 / dev-token-2) is hashed with this exact salt.
TOKEN_SALT=dev-token-salt
