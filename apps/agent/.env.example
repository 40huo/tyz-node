# Control plane (required)
CONTROL_PLANE_URL=http://localhost:8787
NODE_TOKEN=

# Control-plane polling (fallback / safety net)
POLL_INTERVAL_MS=10000

# Stats batch upload
STATS_FLUSH_INTERVAL_MS=60000

# WebSocket config-push channel
WS_ENABLED=true
WS_PROBE_INTERVAL_MS=60000
WS_PING_INTERVAL_MS=60000

# Debug (test-only): true = verbose logs + the embedded GOST Web API
# (read-write surface, e.g. GET /api/config shows the actually-applied config)
# DEBUG=

# GOST Web API listen address — effective only when DEBUG=true.
# Default 127.0.0.1:18080; override when that port conflicts.
# GOST_API_ADDR=
