# Server Configuration
PORT=18090
HOST=127.0.0.1

# GOST API Configuration
GOST_API_URL=http://localhost:18080
# GOST_API_AUTH=username:password  # Uncomment if GOST has authentication

# Control Plane Configuration (Cloudflare Worker)
CONTROL_PLANE_URL=https://your-worker.your-subdomain.workers.dev
NODE_TOKEN=your-node-token

# Polling / Reporting (optional, defaults shown)
# POLL_INTERVAL_MS=10000
# STATS_FLUSH_INTERVAL_MS=60000

# WebSocket push channel (optional, defaults shown)
# WS_ENABLED=true                  # set false to force pure HTTP polling
# WS_PROBE_INTERVAL_MS=60000       # reconnect probe interval after falling back to polling
# WS_PING_INTERVAL_MS=60000        # heartbeat interval; keep < 100000 (edge idle timeout)

# Debug Mode
DEBUG=false
