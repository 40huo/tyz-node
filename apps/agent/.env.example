# Control plane (required)
CONTROL_PLANE_URL=http://localhost:8787
NODE_TOKEN=

# Agent HTTP health endpoint
HOST=127.0.0.1
PORT=18090

# Control-plane polling (fallback / safety net)
POLL_INTERVAL_MS=10000

# Stats batch upload
STATS_FLUSH_INTERVAL_MS=60000

# WebSocket config-push channel
WS_ENABLED=true
WS_PROBE_INTERVAL_MS=60000
WS_PING_INTERVAL_MS=60000

# Optional: expose the embedded GOST Web API for debugging (e.g. 127.0.0.1:18080)
# GOST_API_ADDR=

# DEBUG=true for verbose logs
# DEBUG=
