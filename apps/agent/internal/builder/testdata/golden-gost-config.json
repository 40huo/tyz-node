{
  "services": [
    {
      "name": "service-1",
      "addr": ":8080",
      "limiter": "limiter-service-1",
      "climiter": "climiter-service-1",
      "rlimiter": "rlimiter-service-1",
      "observer": "stats-observer",
      "handler": {
        "type": "tcp",
        "chain": "chain-1"
      },
      "listener": {
        "type": "tcp"
      },
      "forwarder": {
        "nodes": [
          {
            "name": "target-1",
            "addr": "target.example.com:80"
          }
        ]
      },
      "metadata": {
        "enableStats": "true"
      }
    },
    {
      "name": "service-2",
      "addr": ":8443",
      "observer": "stats-observer",
      "handler": {
        "type": "auto",
        "chain": "chain-2"
      },
      "listener": {
        "type": "tcp"
      },
      "metadata": {
        "enableStats": "true"
      }
    }
  ],
  "chains": [
    {
      "name": "chain-1",
      "hops": [
        {
          "name": "hop-1-0",
          "nodes": [
            {
              "name": "node-1-t1",
              "addr": "entry.example.com:80",
              "connector": {
                "type": "relay"
              },
              "dialer": {
                "type": "tcp"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "chain-2",
      "hops": [
        {
          "name": "hop-2-0",
          "nodes": [
            {
              "name": "node-1-t2",
              "addr": "192.168.1.100:10443",
              "connector": {
                "type": "forward"
              },
              "dialer": {
                "type": "tls"
              }
            }
          ]
        },
        {
          "name": "hop-2-1",
          "nodes": [
            {
              "name": "node-3-t2",
              "addr": "192.168.1.100:10005",
              "connector": {
                "type": "relay"
              },
              "dialer": {
                "type": "grpc"
              }
            }
          ]
        },
        {
          "name": "hop-2-2",
          "nodes": [
            {
              "name": "node-4-t2",
              "addr": "192.168.1.100:10006",
              "connector": {
                "type": "forward"
              },
              "dialer": {
                "type": "ws"
              }
            }
          ]
        }
      ]
    }
  ],
  "limiters": [
    {
      "name": "limiter-service-1",
      "limits": ["$ 10485760 20971520"]
    },
    {
      "name": "limiter-conn-1",
      "limits": ["$$ 1048576 2097152"]
    },
    {
      "name": "limiter-ip-1-0",
      "limits": ["192.168.1.50 524288 1048576"]
    }
  ],
  "climiters": [
    {
      "name": "climiter-service-1",
      "limits": ["$ 1000"]
    },
    {
      "name": "climiter-ip-1-0",
      "limits": ["192.168.1.50 50"]
    }
  ],
  "rlimiters": [
    {
      "name": "rlimiter-service-1",
      "limits": ["$ 100"]
    },
    {
      "name": "rlimiter-ip-1-0",
      "limits": ["192.168.1.50 10"]
    }
  ]
}
