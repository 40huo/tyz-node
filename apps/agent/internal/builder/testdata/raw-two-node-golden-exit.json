{
  "services": [
    {
      "name": "service-7",
      "addr": ":26001",
      "observer": "stats-observer",
      "handler": {
        "type": "tcp"
      },
      "listener": {
        "type": "tcp"
      },
      "forwarder": {
        "selector": {
          "strategy": "round",
          "maxFails": 1,
          "failTimeout": 30000000000
        },
        "nodes": [
          {
            "name": "target-7",
            "addr": "127.0.0.1:49180"
          }
        ]
      },
      "metadata": {
        "enableStats": "true"
      }
    },
