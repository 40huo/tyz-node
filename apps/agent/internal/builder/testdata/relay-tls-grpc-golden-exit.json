{
  "services": [
    {
      "name": "service-t4",
      "addr": ":46900",
      "admission": "admission-t4",
      "observer": "stats-observer",
      "handler": {
        "type": "relay",
        "auth": {
          "username": "rtadmin",
          "password": "s3cr3t"
        }
      },
      "listener": {
        "type": "grpc",
        "tls": {
          "certFile": "certs/tls-cert.pem",
          "keyFile": "certs/tls-key.pem",
          "caFile": "certs/ca-cert.pem",
          "options": {
            "minVersion": "VersionTLS13",
            "maxVersion": "VersionTLS13",
            "alpn": [
              "h2"
            ]
          },
          "rejectUnknownSNI": true,
          "serverNames": [
            "relay.example.com"
          ]
        },
        "metadata": {
          "path": "/grpc"
        }
      },
      "metadata": {
        "enableStats": "true"
      }
    }
  ],
  "admissions": [
    {
      "name": "admission-t4",
      "whitelist": true,
      "matchers": [
        "127.0.0.1/32"
      ]
    }
  ]
}
