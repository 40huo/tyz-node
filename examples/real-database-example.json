  "notes": {
    "database_schema": "node",
    "tables": {
      "relay_nodes": "中继节点表 - 注意字段名为 egress_traffic/ingress_traffic 和 display_address",
      "tunnels": "隧道表 - 字段名为 ingress_display_address",
      "chains": "链表 - chain_type 和 transport 为字符串枚举类型",
      "relay_rules": "中继规则表 - limit 为 JSON 对象"
    },
    "chain_type_enum": {
      "in": "入口节点",
      "chain": "中间节点",
      "out": "出口节点"
    },
    "transport_enum": {
      "raw": "直传 (无加密)",
      "ws": "WebSocket",
      "tls": "TLS加密",
      "grpc": "gRPC",
      "wss": "WebSocket Secure",
      "mtls": "双向TLS",
      "mwss": "Multiplexed WebSocket Secure"
    },
    "status_enum": {
      "created": "创建中",
      "paused": "暂停",
      "running": "运行中",
      "error": "错误"
    }
  },
  "edge_function_example": {
    "description": "控制面聚合逻辑的历史参考（Supabase Edge Function 时代）；当前实现见 apps/server/src/db/repo.ts 的 aggregateNodeConfig",
    "sql_logic": [
      "1. 查询 node.relay_nodes WHERE id = $node_id",
      "2. 查询 node.relay_rules WHERE node 相关 (通过 tunnel_id -> chains -> node_id)",
      "3. 查询 node.tunnels WHERE id IN (rule.tunnel_id)",
      "4. 查询 node.chains WHERE tunnel_id IN (...) ORDER BY index",
      "5. 查询 nodes: chains 引用的全部节点记录（含接收节点），供 agent 解析各跳拨址",
      "6. 返回聚合的 JSON 对象 {node, nodes, rules, tunnels, chains, tls?}"
    ],
    "return_format": {
      "node": "RelayNode object（接收节点）",
      "nodes": "RelayNode[]（chains 引用的全部节点记录，含接收节点）",
      "rules": "RelayRule[] array",
      "tunnels": "Tunnel[] array",
      "chains": "Chain[] array",
      "tls": "Optional {commonName, organization}"
    }
  }
