{
  "name": "tyz",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:agent": "bun run --filter @tyz/agent dev",
    "dev:server": "bun run --filter @tyz/server dev",
    "dev:web": "bun run --filter @tyz/web dev",
    "build:web": "bun run --filter @tyz/web build",
    "type-check": "bun run --filter '*' type-check",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "typescript": "^5.7.2"
  }
}
