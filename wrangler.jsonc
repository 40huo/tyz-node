{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tyz-server",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tyz",
      // No database_id on purpose: automatic resource provisioning (wrangler >= 4.45)
      // creates the database on first `wrangler dev` / `wrangler deploy` and keeps it
      // linked by name, so this public repo never carries an account-specific id.
      "migrations_dir": "apps/server/migrations"
    }
  ],
  // Daily stats retention cleanup at 03:00 UTC.
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Per-node WebSocket push channel (see apps/server/src/do/nodePush.ts).
  "durable_objects": {
    "bindings": [
      {
        "name": "CONFIG_PUSH",
        "class_name": "NodePushDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2_node_push_do",
      "new_sqlite_classes": ["NodePushDO"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    // Bind all interfaces so the panel is reachable from the Windows host
    // (via localhost forwarding or the WSL IP) when developing inside WSL.
    "ip": "0.0.0.0",
    "port": 8787
  }
}
